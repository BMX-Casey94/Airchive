# === Airchive Environment Configuration ===

# --- Node ---
NODE_ENV=development
LOG_LEVEL=debug

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airchive
POSTGRES_USER=airchive
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
# Connection pool sizing, applied PER SERVICE. Six services share one Postgres,
# so (services x POSTGRES_POOL_MAX) must stay below the server's
# max_connections (set by POSTGRES_MAX_CONNECTIONS on the postgres container).
# Oversubscribing surfaces as "remaining connection slots are reserved for roles
# with the SUPERUSER attribute" on queries that have nothing to do with the
# service that exhausted the pool.
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10
POSTGRES_ACQUIRE_TIMEOUT_MS=60000
# Guards against a hung query or an abandoned transaction pinning a connection.
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_IDLE_TX_TIMEOUT_MS=60000
# Ceiling on the Postgres container itself.
POSTGRES_MAX_CONNECTIONS=200

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Set this on any host that is not a personal workstation. When set, the compose
# Redis starts with --requirepass and all six services authenticate; when empty,
# Redis accepts unauthenticated commands. An unauthenticated Redis that is
# reachable off-box is a full host compromise, not merely a data leak: the
# attacker repoints `dir` and `dbfilename` and writes an SSH authorised_keys
# file. HOST_BIND_ADDR below is the other half of this defence.
REDIS_PASSWORD=

# --- BSV Blockchain ---
BSV_NETWORK=mainnet
TAAL_ARC_URL=https://arc.taal.com
TAAL_ARC_API_KEY=CHANGE_ME
# Optional secondary ARC upstream. GorillaPool's public ARC does not require an API key.
# Their ARC API docs expose routes under /v1, so the base URL here remains the host root.
GORILLAPOOL_ARC_URL=https://arc.gorillapool.io
GORILLAPOOL_ARC_API_KEY=
WOC_API_URL=https://api.whatsonchain.com/v1/bsv/main
# --- Arcade (Teranode-native broadcaster, Arc-compatible) ---
# Preferred upstream when set; ARC above stays wired as the fallback so an
# Arcade outage degrades throughput rather than stopping writes.
ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech
ARCADE_API_KEY=
ARCADE_BATCH_WINDOW_MS=200
ARCADE_MAX_BATCH_SIZE=100
# Outbound SSE status stream; needs no inbound reachability, unlike ARC callbacks.
ARCADE_SSE_ENABLED=true
# Defaults to a stable value derived from WALLET_MASTER_SEED when unset.
ARCADE_CALLBACK_TOKEN=
# ARC pressure shaping
ARC_MAX_CONCURRENT_BROADCASTS=80
ARC_MAX_QUEUE_DEPTH=640
# Additional retries after the initial transient failure attempt
ARC_TRANSIENT_RETRY_ATTEMPTS=0
ARC_TRANSIENT_RETRY_BASE_MS=250
ARC_CIRCUIT_FAILURE_THRESHOLD=64
ARC_CIRCUIT_WINDOW_MS=10000
ARC_CIRCUIT_OPEN_MS=5000

# --- Wallet Vault ---
# BIP39 mnemonic for HD wallet master seed (store in HSM/Vault in production)
WALLET_MASTER_SEED=CHANGE_ME_NEVER_COMMIT_THIS
# Funding wallet private key WIF (for auto-refill operations)
FUNDING_WALLET_WIF=CHANGE_ME

# --- Data Sources ---
# adsb.fi is the primary source (free, no API key, rich data)
ADSBFI_API_URL=https://opendata.adsb.fi/api/v2
# OpenSky is disabled by default (credit-based, limited data fields)
OPENSKY_ENABLED=false
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_API_URL=https://opensky-network.org/api
RTL_SDR_ENDPOINT=http://localhost:8080/data/aircraft.json
RTL_SDR_ENABLED=false

# --- Ingestion ---
POLL_INTERVAL_MS=1000
# Comma-separated ICAO hex codes of aircraft to track. Ingestion calls adsb.fi
# GET /hex/{csv} in batches of 20 per poll (see services/ingestion/src/clients/adsbfi.ts);
# each extra ~20 hex codes adds another HTTP request per cycle. The dashboard WebSocket
# only relays Redis pub/sub to subscribers — it does not download a global ADS-B snapshot.
# Generate candidate lists: node scripts/fetch-tracked-aircraft-from-opensky.mjs --max 200
TRACKED_AIRCRAFT=4076E8,407798,4072C7,4072C8,407131,4077D3,4CA242,4CA568,43C6B8,43C6F3,43C6F9,43C918,43C919,43C5EB,43C61D
# Demo replay: publishes recorded telemetry to Redis (no live ADS-B polling)
DEMO_MODE=false
# Optional; when unset, uses services/ingestion dist (or src) data/demo-flights.json next to the module
DEMO_REPLAY_PATH=
DEMO_SPEED_MULTIPLIER=1

# --- Write Rate Overrides (ms per phase, lower = more TX/s) ---
# The values below are the built-in defaults, shown for reference. Every
# airborne phase sits at 1000ms because that is the rate ADS-B itself updates
# at — sampling faster only duplicates records. Raising these above 1000 during
# flight discards real state changes, so override with care.
# WRITE_RATE_PARKED_MS=60000
# WRITE_RATE_TAXI_MS=2000
# WRITE_RATE_TAKEOFF_MS=1000
# WRITE_RATE_CLIMB_MS=1000
# WRITE_RATE_CRUISE_MS=1000
# WRITE_RATE_DESCENT_MS=1000
# WRITE_RATE_APPROACH_MS=1000
# WRITE_RATE_LANDING_MS=1000
# WRITE_RATE_TAXI_IN_MS=2000

# --- Gateway ---
GATEWAY_PORT=4000
GATEWAY_WS_PORT=4001
# The gateway refuses to start if this is left as a placeholder while
# authentication is enabled, because tokens signed with a value published in
# this repository can be forged by anyone. Generate one per environment:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRY=24h
# Comma-separated list of the origins allowed to call the API from a browser.
# When the dashboard is hosted separately from the API, list every origin it is
# served from (apex and www if both are used). Do not include a trailing slash —
# browsers never send one. "*" is accepted but logs a warning: it lets any site
# on the internet read this API using a visitor's browser.
# Production example: CORS_ORIGIN=https://www.airchive.uk,https://airchive.uk
CORS_ORIGIN=http://localhost:3000
# Per-IP request ceiling for the gateway. The dashboard alone issues several
# polling requests per second; keep this comfortably above that load.
GATEWAY_RATE_LIMIT_MAX=2000
# Disables authentication entirely and enables a hard-coded development login.
# Off unless explicitly "true". Never set this on a reachable host.
GATEWAY_DEV_AUTH_BYPASS=false

# --- Overlay Node ---
OVERLAY_PORT=4010
OVERLAY_TOPIC=tm_airchive

# --- Alert Engine ---
ALERT_ENGINE_PORT=4020
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_EMAIL_TO=
ALERT_SMS_TO=

# --- Auto-refill ---
ARC_CALLBACK_PORT=9092
REFILL_THRESHOLD_SATS=1500
REFILL_AMOUNT_SATS=64000
# Maintain a deeper chain-head pool so active aircraft can ride through
# propagation cooldowns and refill lag without collapsing into retry buffering.
ACTIVE_AIRCRAFT_UTXO_TARGET=96
ACTIVE_AIRCRAFT_READY_UTXO_TARGET=48
# Reserve ready outputs away from retry traffic for active aircraft.
RETRY_READY_UTXO_RESERVE=12
# When an aircraft hits orphan/dependency pressure, temporarily target a hotter
# ready pool and apply per-aircraft retry backoff with jitter.
RETRY_PRESSURE_READY_UTXO_BOOST=12
RETRY_PRESSURE_WINDOW_MS=30000
RETRY_BACKOFF_MS=12000
RETRY_BACKOFF_JITTER_MS=3000
REFILL_MIN_OUTPUT_SATS=1500
REFILL_CHECK_INTERVAL_MS=5000
REFILL_MAX_OUTPUTS_PER_TX=40
REFILL_MAX_CONCURRENT=64
FUNDING_POOL_SPLIT_TARGET=256
# Skip auto-refill for aircraft with no write activity within this window (ms, default 30 min)
REFILL_IDLE_WINDOW_MS=1800000

# --- Funding recovery state machine ---
# Persisted in Postgres, so a dry treasury recovers unattended no matter how
# long the outage lasts. See deploy/README.md section 10.
FUNDING_CHECK_INTERVAL_MS=15000
# Treasury enters LOW below this many refills' worth of balance.
FUNDING_LOW_WATERMARK_REFILLS=20
# On-chain poll cadence while dry: starts here and backs off to the ceiling.
FUNDING_DRY_POLL_BASE_MS=30000
FUNDING_DRY_POLL_MAX_MS=600000
# Minimum gap between repeat DRY alerts, so an outage does not page all night.
FUNDING_ALERT_REPEAT_MS=3600000
# Held writes released per retry cycle during recovery, to avoid a stampede.
FUNDING_RECOVERY_DRAIN_BATCH=25

# --- Agent Marketplace ---
# Private keys for agent wallets (auto-generated on first run if empty; persist for stable addresses)
COLLECTOR_AGENT_KEY=
ANALYST_AGENT_KEY=
MONITOR_AGENT_KEY=
AGENT_ANALYSIS_INTERVAL_MS=30000
AGENT_MONITOR_INTERVAL_MS=5000
AGENT_METRICS_PORT=9093
BSV_STORAGE_URL=https://storage.babbage.systems

# --- Dashboard ---
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4001/ws
NEXT_PUBLIC_CESIUM_ION_TOKEN=CHANGE_ME

# --- Docker Compose: host-side published ports ---
# These are the ports published on the *host* only. They are deliberately
# separate from POSTGRES_PORT/REDIS_PORT above, which are the ports the
# applications dial: inside the compose network that is always 5432/6379, and
# docker-compose.yml pins those per service. 15432 avoids the Windows reserved
# range that blocks 5432.
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=6379
DASHBOARD_HOST_PORT=3000

# Interface the published ports above bind to. Loopback by default so that only
# nginx faces the internet; a tunnel or reverse proxy on the host still reaches
# everything through 127.0.0.1.
#
# Changing this to 0.0.0.0 exposes Postgres, Redis, the gateway, the overlay
# node and the dashboard directly. Note that firewalld will NOT save you:
# Docker writes its own rules into the DOCKER chain, which is evaluated before
# the firewalld zones, so a host allowing only 22/80/443 still publishes these.
HOST_BIND_ADDR=127.0.0.1

# --- Self-hosted Arcade broadcaster ---
# Consumed by the blockchain-writer. docker-compose.yml pins ARCADE_URL to the
# in-network address, so this value only applies when running the writer
# outside Docker.
ARCADE_URL=http://localhost:3011
# Shared by transaction submissions and the SSE status stream so Arcade's
# status events can be matched back to our broadcasts. Generate with
# `openssl rand -hex 32`. NOTE: this belongs to the blockchain-writer, not to
# Arcade — the compose file intentionally does not pass it into the arcade
# container, where an ARCADE_-prefixed name would be read as Arcade's own
# Merkle Service callback token.
ARCADE_CALLBACK_TOKEN=CHANGE_ME
# Host publish address/port for the arcade container. Loopback by default
# because the Arc-compatible API is unauthenticated.
ARCADE_BIND_ADDR=127.0.0.1
ARCADE_HOST_PORT=3011
# The following ARE Arcade's own configuration keys (viper reads any
# ARCADE_-prefixed variable as a config override).
ARCADE_NETWORK=mainnet
ARCADE_LOG_LEVEL=info
# Required by Arcade: one or more Teranode broadcast endpoints, comma-separated.
ARCADE_TERANODE_BROADCAST_URLS=https://arc.taal.com
ARCADE_TERANODE_AUTH_TOKEN=
# Leave empty to disable the Merkle Service integration. If set, Arcade also
# requires its own callback token or it refuses to start.
ARCADE_MERKLE_SERVICE_URL=

# --- VPS deployment (docker-compose.prod.yml) ---
# The stable domain that replaces the Cloudflare quick tunnels. PUBLIC_ORIGIN
# and PUBLIC_WS_ORIGIN are baked into the dashboard bundle at image build time,
# so changing them requires a rebuild, not just a restart.
PUBLIC_DOMAIN=airchive.example.com
PUBLIC_ORIGIN=https://airchive.example.com
PUBLIC_WS_ORIGIN=wss://airchive.example.com/ws
# Where verified Postgres dumps are written on the host.
BACKUP_PATH=/var/backups/airchive
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# In production these five move out of this file into /etc/airchive/secrets and
# are injected as *_FILE by docker-compose.prod.yml:
#   POSTGRES_PASSWORD, WALLET_MASTER_SEED, FUNDING_WALLET_WIF,
#   TAAL_ARC_API_KEY, JWT_SECRET
# Delete them from here once the secret files exist — see deploy/README.md.
